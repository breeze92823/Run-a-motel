# Skips the Bloxity SDK (sdk.bloxity.io) and avatar CDN (static.bloxity.io) so local dev never depends on them.
VITE_DEV_MODE=false

# Dev server only: tell the Bloxity SDK it runs against a LOCAL Boxity platform
# (portal :3000, API :4000, this game's server :2567). Leave unset to use prod.
BLOXITY_LOCAL=false
